# Local database from compose.yaml (start it with: docker compose up -d)
# For Neon, paste your Neon connection string here instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typing_app"

# Signs the login cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# The address the app runs at (Google redirects back here).
APP_URL="http://localhost:5173"

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
